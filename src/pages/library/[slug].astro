---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { guides, getGuide, glossary } from '../../data/resources.mjs';
import { site } from '../../data/site.mjs';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const g = getGuide(slug);
const otherGuides = guides.filter((x) => x.slug !== slug).slice(0, 3);
---

<Base title={g.title} description={g.teaser}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/library/">Library</a> / {g.title}
    </nav>
  </div>

  <section class="masthead" style="padding-bottom:0.5rem;">
    <div class="container article-head">
      <span class="eyebrow">{g.group}</span>
      <h1>{g.title}</h1>
      <p class="sub">{g.intro}</p>
      <div class="article-meta">
        <span>{g.read}</span>
        <span>Updated {site.publishNote}</span>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:1rem;">
    <div class="container">
      <div class="article-shell">
        <aside class="toc" aria-label="Contents">
          <h4>In this guide</h4>
          {g.sections.map((s, i) => <a href={`#sec-${i}`}>{s.h}</a>)}
        </aside>

        <article class="prose">
          {g.sections.map((s, i) => (
            <div id={`sec-${i}`}>
              <h2>{s.h}</h2>
              {s.body.map((p) => <p>{p}</p>)}
              {s.bullets && s.bullets.length > 0 && <ul>{s.bullets.map((b) => <li>{b}</li>)}</ul>}
            </div>
          ))}

          <div class="takeaways">
            <h3>Key takeaways</h3>
            <ul>
              {g.takeaways.map((t) => <li>{t}</li>)}
            </ul>
          </div>

          {g.faqs && g.faqs.length > 0 && (
            <div>
              <h2>Common questions</h2>
              <Faq items={g.faqs} />
            </div>
          )}

          <div class="note" style="margin-top:2rem;">
            {g.related && g.related.href ? (() => {
              const last = g.related.href.split('/').filter(Boolean).at(-1);
              const target = last === 'business' || last === 'rates' ? '/compare/' : `/compare/${last}/`;
              const label = last === 'rates' ? 'See the full comparison table and published rates' : g.related.label;
              return <>The numbers behind this. <a href={target} style="color:inherit; font-weight:700;">{label}</a></>;
            })() : (
              <>Want numbers behind this? Browse the <a href="/compare/" style="color:inherit; font-weight:700;">comparison table</a></>
            )}
          </div>

          <div class="note" style="background:transparent; border:1px solid var(--border); color:var(--muted);">
            <strong>Don’t know a term?</strong> Check the <a href="/glossary/" style="color:var(--accent-strong); font-weight:700;">glossary</a> — {glossary.length} terms translated.
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Keep reading</span>
        <h2>More from the library</h2>
      </div>
      <div class="grid-articles">
        {otherGuides.map((o) => (
          <a class="article-card" href={`/library/${o.slug}/`}>
            <div class="meta-line">{o.group}</div>
            <h3>{o.title}</h3>
            <span class="read">{o.read} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const links = Array.from(document.querySelectorAll('.toc a'));
  const heads = links.map((a) => document.querySelector(a.getAttribute('href')));

  const spy = () => {
    let current = 0;
    const pos = window.scrollY + 120;
    heads.forEach((h, i) => {
      if (h && h.offsetTop <= pos) current = i;
    });
    links.forEach((l, i) => l.classList.toggle('active', i === current));
  };

  window.addEventListener('scroll', spy, { passive: true });
  spy();
</script>