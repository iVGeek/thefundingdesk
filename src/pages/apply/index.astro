---
import Base from '../../layouts/Base.astro';
import ApplyForm from '../../components/ApplyForm.astro';
---

<Base
  title="Apply | The Funding Desk"
  description="Start a funding application at The Funding Desk — two minutes, soft check only, written offer before you commit."
>
  <section class="masthead" style="padding-bottom:1rem;">
    <div class="container" style="max-width:820px;">
      <span class="eyebrow">Apply</span>
      <h1>Read it. Then apply on your own terms.</h1>
      <p class="sub">Two minutes, a soft check, and an underwriter who confirms pricing in writing before you commit to anything.</p>
      <ApplyForm />
    </div>
  </section>
</Base>