---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import { products, getProduct } from '../../data/products.mjs';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = getProduct(slug);
const others = products.filter((x) => x.slug !== slug);
---

<Base title={p.meta.title} description={p.meta.description}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/compare/">Compare</a> / {p.name}
    </nav>
  </div>

  <section class="masthead" style="padding-bottom:0.5rem;">
    <div class="container">
      <span class="eyebrow">{p.category}</span>
      <h1>{p.hero.h1}</h1>
      <p class="sub">{p.hero.sub}</p>
      <p class="note" style="display:inline-block;">{p.hero.note}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container" style="max-width:820px;">
      <table class="data">
        <thead>
          <tr><th>Quick facts</th><th></th></tr>
        </thead>
        <tbody>
          <tr><td>Headline rate</td><td><b>{p.hook}</b></td></tr>
          <tr><td>Facility size</td><td>{p.band}</td></tr>
          <tr><td>Term</td><td>{p.term}</td></tr>
          {p.stats.map((s) => (
            <tr><td>{s.label}</td><td><b>{s.value}</b></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container">
      <div class="grid-articles" style="grid-template-columns:1fr 1fr;">
        <div class="card">
          <span class="eyebrow">{p.useCases.eyebrow}</span>
          <h3 style="margin:.5rem 0;">{p.useCases.heading}</h3>
          <ul class="tick-list" style="margin-bottom:0;">
            {p.useCases.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div class="card">
          <span class="eyebrow">{p.benefits.eyebrow}</span>
          <h3 style="margin:.5rem 0;">{p.benefits.heading}</h3>
          <ul class="tick-list" style="margin-bottom:0;">
            {p.benefits.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h2>{p.name} — rates</h2>
        <p>{p.rates.lead}</p>
      </div>
      <table class="data" style="margin-top:1rem;">
        <thead>
          <tr>{p.rates.table.columns.map((c) => <th>{c}</th>)}</tr>
        </thead>
        <tbody>
          {p.rates.table.rows.map((r) => (
            <tr>{r.map((c, i) => (i === 0 ? <td><b>{c}</b></td> : <td>{c}</td>))}</tr>
          ))}
        </tbody>
      </table>
      <p class="note" style="margin-top:1rem;">{p.rates.note}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container">
      <div class="grid-articles" style="grid-template-columns:1fr 1fr;">
        <div class="card">
          <span class="eyebrow">Criteria</span>
          <h3 style="margin:.5rem 0;">{p.criteria.heading}</h3>
          <ul class="tick-list" style="margin-bottom:0;">
            {p.criteria.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
        <div class="card">
          <span class="eyebrow">Fees</span>
          <h3 style="margin:.5rem 0;">{p.fees.heading}</h3>
          <ul class="tick-list" style="margin-bottom:0;">
            {p.fees.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{p.example.eyebrow}</span>
        <h2>{p.example.heading}</h2>
      </div>
      <table class="data">
        <tbody>
          {p.example.ledger.map((l) => (
            <tr><td>{l.label}</td><td style="text-align:right; font-weight:700;">{l.value}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="note" style="margin-top:1rem;">{p.example.note}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container" style="max-width:820px;">
      <div class="section-head">
        <span class="eyebrow">Process</span>
        <h2>{p.process.heading}</h2>
      </div>
      <div class="prose">
        {p.process.steps.map((s) => (
          <p><b>Step {s.n}: {s.title}.</b> {s.copy}</p>
        ))}
      </div>
      <div style="margin-top:1.5rem;">
        <a class="btn btn-primary" href="/apply/">Apply</a> {''}
        <a class="btn btn-ghost" href="/contact/">Ask a question</a>
      </div>
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border);">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">FAQs</span>
        <h2>Straight answers</h2>
      </div>
      <Faq items={p.faqs} />
    </div>
  </section>

  <section class="section" style="padding-top:0.5rem;">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Compare</span>
        <h2>Other products to weigh up</h2>
      </div>
      <div class="grid-articles" style="grid-template-columns:1fr 1fr;">
        {others.slice(0, 4).map((x) => (
          <a class="card" href={`/compare/${x.slug}/`} style="text-decoration:none;">
            <b style="color:var(--accent-strong); font-size:.9rem;">{x.hook}</b>
            <h3 style="margin:.35rem 0;">{x.name}</h3>
            <p style="color:var(--muted); margin:0; font-size:.95rem;">{x.band} · {x.term}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>