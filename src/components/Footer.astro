---
import { site } from '../data/site.mjs';
import { guides, glossary } from '../data/resources.mjs';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-cols">
      <div>
        <h4>The Library</h4>
        <ul>
          {guides.slice(0, 6).map((g) => (
            <li><a href={`/library/${g.slug}/`}>{g.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Compare</h4>
        <ul>
          <li><a href="/compare/">Compare all products</a></li>
          <li><a href="/compare/unsecured-business-loans/">Unsecured business loans</a></li>
          <li><a href="/compare/residential-bridging/">Residential bridging</a></li>
          <li><a href="/compare/commercial-bridging/">Commercial bridging</a></li>
        </ul>
      </div>
      <div>
        <h4>Reference</h4>
        <ul>
          <li><a href="/glossary/">Glossary</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/apply/">Apply</a></li>
          <li><a href="/legal/">Legal &amp; compliance</a></li>
        </ul>
      </div>
      <div>
        <h4>{site.name}</h4>
        <p class="disclosure" style="margin-top:0;">{site.footerNote}</p>
      </div>
    </div>
    <div class="footer-bottom">
      {site.phone} · {site.email} · {site.publishNote}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--panel);
    margin-top: 4rem;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding: 2.5rem 0 1.5rem;
  }

  .footer-cols h4 {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .footer-cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-cols a {
    display: block;
    padding: 0.22rem 0;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .footer-cols a:hover {
    color: var(--accent-strong);
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding: 1.1rem 0;
    color: var(--muted);
    font-size: 0.85rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  @media (max-width: 900px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-cols {
      grid-template-columns: 1fr;
    }
  }
</style>