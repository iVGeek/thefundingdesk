---
import { site } from '../data/site.mjs';
---

<header class="topbar">
  <div class="container topbar-in">
    <a class="brand" href="/">The Funding Desk</a>
    <nav class="nav" aria-label="Main">
      <a href="/library/">Library</a>
      <a href="/compare/">Compare</a>
      <a href="/glossary/">Glossary</a>
      <a href="/about/">About</a>
    </nav>
    <div class="actions">
      <a class="btn btn-primary" href="/apply/">Apply</a>
    </div>
    <details class="mobile">
      <summary aria-label="Menu">☰</summary>
      <div class="mobile-links">
        <a href="/library/">Library</a>
        <a href="/compare/">Compare</a>
        <a href="/glossary/">Glossary</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a class="btn btn-primary" href="/apply/">Apply</a>
      </div>
    </details>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
  }

  .topbar-in {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 62px;
  }

  .brand {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    gap: 1.4rem;
    margin-left: auto;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav a:hover {
    color: var(--accent-strong);
  }

  .actions {
    display: flex;
    align-items: center;
  }

  .mobile {
    display: none;
    margin-left: auto;
  }

  .mobile summary {
    list-style: none;
    cursor: pointer;
    font-size: 1.4rem;
    padding: 0.2rem 0.4rem;
  }

  .mobile-links {
    position: absolute;
    left: 0;
    right: 0;
    top: 62px;
    background: var(--panel);
    border-bottom: 1px solid var(--border);
    padding: 1rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .mobile-links a {
    text-decoration: none;
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 720px) {
    .nav {
      display: none;
    }

    .mobile {
      display: block;
    }
  }
</style>